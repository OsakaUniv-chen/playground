# =============================================================
# vlm-server 的配置。run.sh 会 source 这个文件。
#
# **这里是配置的唯一出处。** 脚本和代码里不写默认值，未设置就在启动时报错
# 退出（代码里再写一份，改了一边另一边会静默地对不上）。
#
# 例外：whisper 的输入规格（16 kHz 单声道）**不在这里** —— 那不是配置，
# 是模型的硬性要求，改了模型就不工作。写在 asr.py 顶部。
# =============================================================

# ---- 从哪拉流：stream-server 上的 OME ----
# **★ 必须用 tailnet 地址。** 这台机器在理研网（192.168.3.x），和
# stream-server 不同网段 —— `rog-server.local` 和 `192.168.1.10` 在这里
# **都不通**，那是局域网内那几台才用的。
#
# 正式开始之前先看一眼 `tailscale status`：要显示 `direct` 才是打洞成功，
# 还写着 DERP 的话先通信一会儿等它自己升级（架构文档 §7）。
export OME_HOST=100.90.179.60
export OME_WS_PORT=3333
export OME_APP=app

# 取哪几条流。**三条流，四路数据** —— 机体麦克风复用在 fisheye 里
# （架构 §1.1），不是独立的一条。名字要和 robot-pc / tele-pc 推上去的一致，
# 对不上的表现是「signalling 通了但永远没有数据」。
export STREAM_KEY_FISHEYE=fisheye          # 鱼眼画面 ＋ 机体麦克风（两个 track）
export STREAM_KEY_SOUNDMAP=soundmap        # 声音图
export STREAM_KEY_OPERATORMIC=operatormic  # 操作者语音

# 画面交上来的像素格式。VLM 那边一般要 RGB（PIL / transformers 的惯例）；
# 要用 cv2 画图的话改成 BGR。转换由 gst 做，不占 Python 的 CPU。
export VIDEO_FORMAT=RGB

# ---- 视频缓冲（VLM 要多帧输入，架构 §5.1）----
# 留多久 [s]。判断时从这里面按需要取 N 帧、跨多长时间 —— **要几帧、跨多久，
# 是判断那一刻才决定的**，所以这里只要留得够长就行，改取法不用动这边。
export BUFFER_SEC=15
# 按多少帧率往缓冲里塞 [fps]。0 = 来多少存多少。
# **收流照收 30 fps，只是不都往缓冲里塞** —— 全存的话 1080×1080×3 = 3.5 MB/帧，
# 15 秒就是 1.6 GB。5 fps × 15 s = 75 帧 ≈ 262 MB，这台机器 62 GB，很宽裕。
# 要更细的时间分辨率（比如看手势）就调大，内存按比例涨。
export BUFFER_FPS=5

# ---- 转写从 stream-server 拉（架构 §3.1、§5.2）----
# **不在这台机器上做转写了** —— 3090 的 24 GB 要整块留给 VLM。
# 地址用 tailnet：局域网的 rog-server.local / 192.168.1.10 在这里不通。
export TRANSCRIPT_URL=http://100.90.179.60:8770/transcript
# 拉不到就别把判断整个卡住 [s]。
export TRANSCRIPT_TIMEOUT=3

# ---- 判断的节奏和取帧（架构 §5.1）----
# **★ 这三个值都还没定。** 一次吃几帧、跨多长时间、多久判断一次，要接上 VLM
# 之后拿实际效果调。缓冲留了 15 秒，所以怎么改都不用动 stream-server。
export VLM_FRAMES=8            # 每次判断取几帧
export VLM_SPAN=4              # 这几帧跨多少秒（从缓冲里按时间等间隔挑）
export DECIDE_INTERVAL=2       # 多久判断一次 [s]
# 每次拉多长的转写 [s]。**这是查询参数**，改它不用动 stream-server。
export TRANSCRIPT_SECONDS=60

# ---- 日志 ----
# 转写结果一行一条写在 $LOG_DIR/transcript.jsonl。**这是这台机器上唯一的
# 记录** —— 画面和音频本身只在 robot-pc 的 bag 里。事后要对「当时听见了
# 什么」，以及要换上下文窗重放，都靠它。
export LOG_DIR=$HOME/vlm-server/log

# ---- 用哪个 Python ----
# gi（收 WebRTC）和 faster-whisper/CUDA 必须在**同一个** Python 里。
# 做法和 rog-server 一样：--system-site-packages 的 venv，gi 从系统继承，
# 只把 faster-whisper 装进 venv。见 README「环境」。
export VLM_PYTHON=$HOME/vlm-server/venv/bin/python3

# ---- tmux ----
# 所有东西跑在这个 tmux session 里，和 robot-pc 一样，好处有两个：
#   1. 用 ssh 起的话，断线不会把进程一起带走
#   2. 别的机器 ssh 进来之后 `tmux attach -t <这个名字>` 就能看同一个面板
export TMUX_SESSION=vlm
# 状态面板的刷新间隔 [s]。asr.py 也按这个节奏写 status.json。
export STATUS_INTERVAL=2
# asr 进程退出之后隔多久重起 [s]。网络断了、OME 重启了都会让它退。
export RESTART_SEC=5
