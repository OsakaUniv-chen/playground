# =============================================================
# 全 PC 共通の設定。各 PC の run.sh がこれを source する。
# ★ が付いている項目は現地で確認して埋めること。
# =============================================================

# ---- 機体・ROS ----
# ROBOT_NAME は topic の namespace になる（/boxie/rover/twist など）。
# 1 台しか居ないなら機能上は無くてもよいが、沿用元の keigan_motor が
# /<robot>/keigan_motor/... を前提にしているので、そちらを再利用するなら
# 合わせておく。現地で他の機体と同じ AP に入る場合の衝突避けにもなる。
export ROBOT_NAME=boxie

# 3 台で共有する。他所の ROS と混ざらないための一次的な隔離。
export ROS_DOMAIN_ID=215

# 対話 shell では .bashrc で source 済みのことが多い。env.sh は
# ROS_DISTRO が未設定のときだけ読むので、二重 source にはならない。
# systemd や cron から起動する場合は .bashrc が読まれないため、ここで拾う。
#
# **ROS が要るのは PC-B と PC-C だけ。** PC-D は ROS を使わない
# （受信は rclpy 不要、頭部指令は TCP で PC-C へ投げる）。
# 決め打ちにせず、その機械に入っている物を拾う。複数入っている機械では
# 各 PC の config.env で上書きすること。
export ROS_DISTRO_SETUP=${ROS_DISTRO_SETUP:-$(ls -d /opt/ros/*/setup.bash 2>/dev/null | head -1)}

# ---- ネットワーク ★ ----
# PC-A / PC-B / PC-C は同じ LAN。全部の映像・音声が集まる先は PC-C の OME
# なので、実際にアドレスで指すのはここだけ。
export PC_C_IP=192.168.1.100      # 操作者端末（OME サーバ）
#
# **PC-D は理研にあり、同じ LAN に居ない。** PC-C とは Tailscale で繋がるので、
# PC-D 側は PC-C の tailscale アドレスを見る（pc-d-server/config.env の
# OME_HOST）。経緯は todo-list.md の「PC-D だけ別の場所にある」。

# ---- OME ----
# "app" は OME の既定 Server.xml に最初から定義されている application 名。
# URL は rtmp://<host>:1935/<OME_APP>/<stream_key> の形になる。
# 別名にするなら Server.xml に <Application> を追加する必要がある。
# 沿用元も既定のまま app を使っていた。
export OME_APP=app
export OME_RTMP_PORT=1935
export OME_WS_PORT=3333           # signalling（平文）

# 受信側が OME を探しに行く先。既定は PC-C。
# PC-D は理研にあるので、PC-C の tailscale アドレスで上書きする
# （pc-d-server/config.env）。
export OME_HOST=${OME_HOST:-$PC_C_IP}
export STREAM_KEY_MAIN=${ROBOT_NAME}stream
export STREAM_KEY_SOUNDMAP=${ROBOT_NAME}soundmap
export STREAM_KEY_MIC=${ROBOT_NAME}mic
# 操作者マイク。PC-C -> OME -> PC-B（スピーカー）と PC-D（推論）。
# 機体から出る 3 本と違い、これだけは PC-C から OME へ入る。
export STREAM_KEY_OPERATOR_MIC=operatormic

# ---- 頭部指令の中継（PC-D -> PC-C -> ROS -> PC-B）----
# PC-D は理研にあり distro も違うので DDS を跨がせない。素の TCP で
# PC-C の head_relay.py へ送り、そこで ROS に載せ替える。
export HEAD_RELAY_PORT=7997

# ---- 音響マップ（PC-B で生成して OME へ送る）----
export SOUNDMAP_HZ=10              # 生成周期。N100 実測で最大 27 Hz
# 1 枚に使う音声の長さ。周期より長く取り、毎回ずらして使う（スライド窓）。
# 積分時間が S/N と空間分解能を決める一方、計算量もほぼ比例する。
# word-wolf の実測条件に合わせてある:
#   160 msg × 128 sample/ch @44.1 kHz = 20480 sample/ch = 464 ms
export SOUNDMAP_WINDOW_MS=464
export SOUNDMAP_BITRATE=500        # kbps。64×64 ならこれで十分すぎる
# 生成解像度（64×64）のまま送る。情報量は 64×64 しかないので送出側で
# 引き伸ばしても増えない。拡大は受け側（ブラウザの CSS、PC-D の前処理）でやる。
# 生成器は pc-b-robot/soundmap/ に同梱してある（外のディレクトリは参照しない）

# ---- 音声パラメータ（PC-B と PC-D で必ず一致させる） ----
# miniDSP UMA16v2（実機で確認済み）
#   Capture: S32_LE 固定・16ch 固定・24 bit 有効
#   対応レート: 8000 11025 12000 16000 32000 44100 48000（44100 を使う）
# ハード側は S32_LE でしか開けないので、gst の audioconvert で S16LE に
# 落として伝送・記録する。既存の audio_node.py も pyaudio の paInt16 で
# 取っているので、そちらと同じ形式になる。
export MIC_ARRAY_CHANNELS=16
export MIC_ARRAY_RATE=44100
export MIC_ARRAY_HW_FORMAT=S32LE   # デバイスから取る形式（変更不可）
export MIC_ARRAY_FORMAT=S16LE      # 伝送・記録する形式
export MIC_ARRAY_MS_PER_MSG=10     # 1 ROS メッセージあたりの長さ

# ★ デバイスが実際に対応するレートに合わせる。合っていないと caps 交渉に
#   失敗してパイプラインが起動しない。確認は
#     arecord -D <device> --dump-hw-params
#   48 kHz は USB オーディオの一般的な既定値。この音声は映像と一緒に AAC で
#   RTMP に載るので、48 kHz なら再符号化が素直に通る。
export ONBOARD_MIC_CHANNELS=2
export ONBOARD_MIC_RATE=48000

# これは「記録するときのレート」であって伝送レートではない。
# PC-C が 48 kHz の AAC で OME へ入れ、OME が WebRTC 用に Opus へ変換する
# （clock-rate は 48000 固定・RFC 7587）。PC-B は受けてからこのレートに
# 落として記録する。内容が分かればよいので 16 kHz で足りる。
export OPERATOR_MIC_CHANNELS=1
export OPERATOR_MIC_RATE=16000

# ---- 映像パラメータ ----
# Xacti CX-MT500（防塵防水 360° USB カメラ・IP65）
#   200° 広角レンズ / 1/2.3" CMOS / 出力は **Motion JPEG のみ**（H.264 は出ない）
#   1920x1080・1280x720・640x480、30/25/15/10/5 fps
#   USB 2.0 microB、UVC 1.1 + UAC 1.0（モノラルマイク内蔵）
#
# デバイスからは 1920x1080 で取り、中央の 1080x1080 だけを切り出す。
# 左右 420 px を捨てるぶん画素数が 44% 減り、符号化の負荷も帯域も下がる。
# 切り出し位置は既存の camera_node.py（`img[:, 420:1500]`）と同じで、
# 実績のある値。撮影モードは固定で使うので途中で変わる心配は無い。
export CAM_SRC_WIDTH=1920      # デバイスから取る解像度
export CAM_SRC_HEIGHT=1080
export CAM_WIDTH=1080          # 切り出し後（実際に送る解像度）
export CAM_HEIGHT=1080
export CAM_FPS=30
export CAM_BITRATE=8000        # kbps（H.264 符号化）

# カメラは倒立で載る（同じ機体・同じカメラを使い続けるので確定）。
# 既存の camera_node.py が `cv2.flip(img, -1)`（＝180 度回転）を掛けていたのと
# 同じ処理で、無いと操作者にも VLM にも上下逆の映像が行く。
# 取り付け向きを変えたときだけ 0 にする。
export CAM_ROTATE_180=${CAM_ROTATE_180:-1}

# カメラは MJPG しか出さず、OME の入口の RTMP は MJPG を運べないので、
# H.264 への変換は必ず通る。1 のとき、その復号と符号化を iGPU（VA-API）で
# やる。**速度のためではない**（符号化＋復号は実測 1.5 ms で往復 75 ms の中
# では誤差）。狙いは CPU を空けること — PC-B は N100 の 4 コアで音響マップ
# 生成と bag 書き込みも同時に回しており、ソフトウェアの MJPG 復号 + x264 で
# 1.5〜2 コア持っていかれる。
# vaapi 系エレメントが無ければ自動でソフトウェアに戻るので、この値を
# 気にしなくても起動はする（cam_bridge が起動ログにどちらを使ったか出す）。
export USE_HW_CODEC=${USE_HW_CODEC:-1}

# ---- テスト用 ----
# 1 にすると実デバイスの代わりに videotestsrc / audiotestsrc を使う。
# センサが繋がっていない状態で経路の確認ができる。
export USE_FAKE_SOURCES=1
