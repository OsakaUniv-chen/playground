# PC-D（高性能サーバ）固有の設定
#
# PC-D は理研にあり、PC-A/B/C の LAN には居ない。**PC-C とは Tailscale で
# 繋がる**ので、OME も頭部指令も PC-C の tailscale アドレスを直接指す。
# UDP がそのまま通るので TURN も SSH トンネルも要らない。
#
# 注意: **ノード共有（Share device）では駄目。** 共有された側から
# 相手の tailnet へ発起できないため、signalling も頭部指令も通らない。
# 正式メンバーとして同じ tailnet に入れること（todo-list.md 参照）。
export OME_HOST=100.80.23.31      # PC-C の tailscale アドレス

# **この機械に ROS は要らない。**
#   - OME からの受信（recv_ome.py / ome_receiver.py）は gi と numpy だけ
#   - 頭部指令は head_controller.py が TCP で PC-C の head_relay へ投げ、
#     ROS に載せ替えるのは PC-C 側
# もともと PC-D は galactic で、PC-B / PC-C の humble とは既定の RMW が
# 違って素のままでは繋がらない。DDS を跨がせない構成にしたことで、
# distro を揃える必要そのものが無くなった。
#
# 頭部指令の送り先。PC-C の tailscale アドレス。
export HEAD_RELAY_HOST=100.80.23.31

# ---- 文字起こし（asr.py。将来の VLM の入力）----
# **Python が 2 つ要る。** 受信側（audio_send.py）は GStreamer が必要で
# システムの python3（3.8）でしか動かず、faster-whisper は 3.8 に入らない。
# 作り方は README の「環境を作る」。
export ASR_PYTHON=$HOME/p32/venv-asr/bin/python

# audio_send.py -> asr.py の localhost 経路。外には出さない。
export ASR_PORT=7998

# ★ モデル。3090（24 GB）なら large-v3 も載るが、まず medium で様子を見る。
#   medium は float16 で 1.5 GB ほど。GPU を VLM と分け合うようになったら、
#   ここを small に落とすか、ASR_DEVICE=cpu にする余地がある。
export ASR_MODEL=medium
export ASR_DEVICE=cuda
export ASR_COMPUTE_TYPE=float16
# 会場は日本語。**自動判定にしない** ── 数秒の断片では判定を外しやすく、
# 外すと文字起こしが丸ごと別言語になる。
export ASR_LANGUAGE=ja

# ---- 窓は 2 つある。混ぜないこと（asr.py 冒頭の説明）----
# (1) 切り出し: 音声をどこで区切って whisper に渡すか。固定長で切らない。
export ASR_SILENCE_SEC=0.6         # これだけ無音が続いたら発話の終わり
export ASR_MIN_SPEECH_SEC=0.4      # これ未満の音は発話とみなさず捨てる
export ASR_MAX_SEGMENT_SEC=8       # 喋り続けているときの強制的な区切り
# (2) 文脈: VLM に見せる書き起こしの長さ。**頭を誰に向けるか**の判断材料
#     なので、直近 2〜4 ターンぶんで足りる（1 ターンは 2〜8 秒）。
#     長くすると、終わった話題の話者に引きずられ、トークンだけ増える。
#     VLM を繋いだら、まずここだけを動かして調整する。
export ASR_CONTEXT_SEC=15
