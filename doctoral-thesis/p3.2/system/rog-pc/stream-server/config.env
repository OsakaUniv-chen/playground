# =============================================================
# stream-server 的配置。上一层的 run_stream.sh / run_overlay.sh 会 source 它。
#
# **这里是配置的唯一出处。** 脚本里不写默认值，未设置就在启动时报错退出
# （代码里再写一份，改了一边另一边会静默地对不上）。
#
# 例外：检测的算法参数（模型、阈值、输入尺寸、迟滞窗）**不在这里**，
# 全部在 person_detect.py 顶部。那些是算法参数，跟部署无关，
# 放在一起才看得懂。这里只有「从哪拉流、往哪发结果」。
# =============================================================

# ---- 从哪拉流：本机的 OME ----
# 画面本来就已经到了 OME，检测节点和 OME 同机，所以走 loopback。
# **不要写成 rog-server.local** —— 同一台机器，那会绕一圈出去再回来，白白多一跳。
export OME_HOST=127.0.0.1
export OME_WS_PORT=3333
export OME_APP=app

# 取哪条流。和 system-architecture.md §1.1 的表、robot-pc/config.env 的
# KEY_FISHEYE / KEY_SOUNDMAP 一致。对不上的表现是「signalling 通了但永远
# 收不到画面」。
export STREAM_KEY_FISHEYE=fisheye
export STREAM_KEY_SOUNDMAP=soundmap

# ---- 往哪推：两条合成流，推回本机的 OME ----
# 这两条是**给人看的监视流**，不进 bag，也不参与任何判断。做出来是为了在
# OvenPlayer 上一眼就能确认「检测在不在工作」「声音图和画面对不对得上」。
#
#   detect  鱼眼 ＋ 检测框 ＋ 右上角的录制标志（5 fps，跟着检测的节奏）
#   rgb_sm  鱼眼 ＋ 声音图叠加（跟着鱼眼的节奏）
#
# 进 OME 一律 SRT（§1.1），streamid 里带 vhost/app/key。**推回的是本机**，
# 所以 OME_HOST 还是上面那个 127.0.0.1。
export OME_SRT_PORT=9999
export OME_VHOST=default
export SRT_LATENCY=20              # loopback，20 ms 绰绰有余
export STREAM_KEY_DETECT=detect
export STREAM_KEY_RGB_SM=rgb_sm
export DETECT_BITRATE=2000         # kbps。5 fps 的监视流，够了
export RGB_SM_BITRATE=4000         # kbps
# 1 = 优先用核显（VA-API）编码。缺 element 时自动退回 x264，日志会说用的哪个。
export USE_HW_CODEC=1

# ---- 往哪发结果：ROS ----
# topic 是 /<ROBOT_NAME>/record/trigger（std_msgs/Bool）。要和 robot-pc 的 recorder 对齐。
export ROBOT_NAME=boxie
# ROS 的域号。**0 是所有人的默认值** —— 同一个 LAN 上别人的 ROS 节点会和
# 我们互相发现，topic 撞名、trigger 被别的东西盖掉都可能。32 取自 P3.2，
# 好记又不常用。**两台机器必须一致**（robot-pc / rog-pc），
# 对不上的表现是 robot-pc 永远收不到 trigger，于是一直 fail-open 连续录。
export ROS_DOMAIN_ID=32
# **rclpy 只有 source 过这个才 import 得到。** venv 是 --system-site-packages
# 建的，所以 source 之后 venv 里也能 import。run_stream.sh 在生产模式下自动
# source（test 模式不发 ROS，用不到）。换 distro 就改这里。
export ROS_SETUP=/opt/ros/jazzy/setup.bash

# ---- 日志 ----
export LOG_DIR=$HOME/rog-pc/log

# ---- 模型权重放哪 ----
# ultralytics 默认会往当前目录下载权重。固定到一个地方，免得每次换工作
# 目录就重下一遍，也免得权重跟着 git 走。
export YOLO_WEIGHTS_DIR=$HOME/rog-pc/weights

# ---- 用哪个 Python ----
# venv / weights / log 都在 ~/rog-pc 下，和代码同级但**不进 git** ——
# 往 rog-server 同步时只 rsync 代码子目录（stream-server / tele-server /
# run_*.sh），别 --delete 整个 ~/rog-pc，那会把 venv 和权重一起删掉。
#
# 这个进程要同时用 gi（收 WebRTC）、torch/ultralytics（推理）和 rclpy（发结果），
# 三样必须在**同一个** Python 里。做法见 README「环境」：
# 建一个 --system-site-packages 的 venv，让 gi 和 rclpy 从系统继承进来，
# 只把 ultralytics/torch 装进 venv。
export ROG_PYTHON=$HOME/rog-pc/venv/bin/python3

# =============================================================
# 语音转文字（ASR）—— run_asr.sh 用的那一段
#
# **为什么 ASR 在这台机器上而不是 vlm-server。** 3090 那边要装 VLM：
# Qwen2.5-VL-32B-AWQ 约 20 GB，加上 whisper 的 1.8 GB 就把 24 GB 顶满了
# （vLLM 默认 gpu_memory_utilization=0.9 = 22.1 GB，再加 whisper 直接爆）。
# 挪到这里之后 3090 整块给 VLM，而这台的 4070 只被 YOLO 用掉 920 MiB / 7808 MiB。
#
# **是独立进程、独立 venv**（run_asr.sh + ~/rog-pc/venv-asr）。理由有两条：
#   ① ctranslate2 要 CUDA 12 的 cudnn，而现有 venv 里的 torch 是 cu130 —— 同一个
#      进程里两套 CUDA runtime 是已知的麻烦源，分开就没这回事；
#   ② 职责不同。ASR 挂了不该连累人物检测（那条 5 Hz 的判定管着录制触发）。
# =============================================================

# 音频从本机 OME 拉（loopback）。**机体麦克风复用在 fisheye 里**（§1.1），
# 所以那条流要连，只接音频 pad 不接视频。
export STREAM_KEY_OPERATORMIC=operatormic
# recv.py 的 Inputs 一律要这个键；ASR 不取视频，填什么都行。
export VIDEO_FORMAT=RGB

# ★ 模型。4070 Laptop 是 8 GB，YOLO 已经占 920 MiB。medium（float16 约 1.8 GB）
#   放得下，但**它和 YOLO 抢的是算力不是显存** —— YOLO 每 200 ms 用掉 93 ms，
#   whisper 的推理是突发的。跟不上就降到 small。
export ASR_MODEL=medium
export ASR_DEVICE=cuda
export ASR_COMPUTE_TYPE=float16
# 会场是日语。**不用自动判定** —— 几秒的片段容易判错，一错整段变成另一种语言。
export ASR_LANGUAGE=ja
export ASR_MODEL_DIR=$HOME/rog-pc/models

# ---- 两个窗是两回事，别混（asr.py 文件头有详细说明）----
# (1) **切分的窗**：音频在哪里断开送给 whisper。**不按固定长度切**。
export ASR_SILENCE_SEC=0.6         # 静音连续这么久 = 一句话说完了
export ASR_MIN_SPEECH_SEC=0.4      # 比这短的声音不当发话，丢掉
export ASR_MAX_SEGMENT_SEC=8       # 一直说不停时的强制断点
# (2) **上下文的窗**：给 VLM 看多长的转写。改了要重起 run_asr.sh。
export ASR_CONTEXT_SEC=60
# 内存里留多久的发话。比上下文窗长得多是故意的：窗还要调，留长一点才能
# 在同一次运行里比较不同的值。只是些文本，600 秒几十 KB。
export ASR_KEEP_SEC=600

# 用哪个 Python。**和 ROG_PYTHON 是两个环境**（见本段开头的理由 ①）。
# 这台是 24.04，系统 gi 就是 3.12 的，所以 --system-site-packages 能继承过来，
# 只需要把 faster-whisper 装进去。建法见 README「环境」。
export ASR_PYTHON=$HOME/rog-pc/venv-asr/bin/python3

# ---- 转写的 HTTP 出口（架构 §3.1）----
# vlm-server 从这里拉最近 N 秒的转写。**只有这一个端点，而且是拉不是推。**
#
# 绑 0.0.0.0：vlm-server 走 tailnet 过来，而 tailscale 的地址要等它起来才有 ——
# 绑死那个地址的话，tailscale 没起时这个服务就起不来。代价是局域网内也看得见，
# 和同机的 OME（3333/9999 也是全开的）在同一个信任域里，可以接受。
export ASR_HTTP_HOST=0.0.0.0
export ASR_HTTP_PORT=8770

# ---- recv.py 的视频缓冲 ----
# **这台机器用不上**（ASR 只收音频），但 recv.py 和 vlm-server 那份要保持
# 逐字节一致，而它一律读这两个键。留着，值无所谓。
export BUFFER_SEC=0
export BUFFER_FPS=0
