# =============================================================
# stream-server 的配置。上一层的 run_stream.sh / run_overlay.sh / run_asr.sh
# 会 source 它。**配置的唯一出处**，脚本里不写默认值，未设置就报错退出。
#
# 例外：检测的算法参数（模型、阈值、输入尺寸、迟滞窗）**不在这里**，
# 全部在 person_detect.py 顶部。这里只有「从哪拉流、往哪发结果」。
# =============================================================

# ---- 从哪拉流：本机的 OME ----
# **不要写成 rog-server.local** —— 同一台机器，那会绕一圈出去再回来。
export OME_HOST=127.0.0.1
export OME_WS_PORT=3333
export OME_APP=app

# 要和 robot-pc/config.env 的 KEY_FISHEYE / KEY_SOUNDMAP 一致。对不上的表现是
# 「signalling 通了但永远收不到画面」。
export STREAM_KEY_FISHEYE=fisheye
export STREAM_KEY_SOUNDMAP=soundmap

# ---- 往哪推：两条监视流，推回本机的 OME ----
#   human_detect  鱼眼 ＋ 检测框 ＋ 右上角的录制标志（5 fps）
#   rgb_sm        鱼眼 ＋ 声音图叠加（跟着鱼眼的节奏）
export OME_SRT_PORT=9999
export OME_VHOST=default
export SRT_LATENCY=20              # loopback，20 ms 绰绰有余
export STREAM_KEY_DETECT=human_detect
export STREAM_KEY_RGB_SM=rgb_sm
export DETECT_BITRATE=2000         # kbps
export RGB_SM_BITRATE=4000         # kbps
# 1 = 优先用核显（VA-API）。缺 element 时自动退回 x264，日志会说用的哪个。
export USE_HW_CODEC=1

# ---- 往哪发结果：ROS ----
# topic 是 /<ROBOT_NAME>/record/trigger（std_msgs/Bool）。
# **要和 robot-pc 的 config.env 一致** —— 对不上的表现是 robot-pc 永远收不到
# trigger，于是一直 fail-open 连续录。
export ROBOT_NAME=boxie
# **两台机器必须一致**，对不上同样是一直 fail-open。不用 0：那是所有人的默认值，
# 同一个 LAN 上别人的 ROS 节点会和我们互相发现。
export ROS_DOMAIN_ID=32
# **rclpy 只有 source 过这个才 import 得到。** run_stream.sh 在生产模式下自动
# source（test 模式不发 ROS，用不到）。换 distro 就改这里。
export ROS_SETUP=/opt/ros/jazzy/setup.bash

# ---- 日志 ----
export LOG_DIR=$HOME/rog-pc/log

# ---- 模型权重放哪 ----
# 固定住，免得 ultralytics 每次换工作目录就往那儿重下一遍。
export YOLO_WEIGHTS_DIR=$HOME/rog-pc/weights

# ---- 用哪个 Python ----
# 这个进程要同时用 gi（收 WebRTC）、torch/ultralytics（推理）和 rclpy（发结果），
# **三样必须在同一个 Python 里**。建法见 README「环境」。
export ROG_PYTHON=$HOME/rog-pc/venv/bin/python3

# =============================================================
# 语音转文字（ASR）—— run_asr.sh 用的那一段。独立进程、独立 venv。
# =============================================================

# 音频从本机 OME 拉。机体麦克风复用在 fisheye 里，所以那条流要连，
# 只接音频 pad 不接视频。
export STREAM_KEY_OPERATORMIC=operatormic
# recv.py 的 Inputs 一律要这个键；ASR 不取视频，填什么都行。
export VIDEO_FORMAT=RGB

# ★ 模型。medium（float16 约 1.8 GB）和 YOLO **抢的是算力不是显存**，
#   实测可以接受（见 README）。跟不上就降到 small。
export ASR_MODEL=medium
export ASR_DEVICE=cuda
export ASR_COMPUTE_TYPE=float16
# 会场是日语。**不用自动判定** —— 几秒的片段容易判错，一错整段变成另一种语言。
export ASR_LANGUAGE=ja
export ASR_MODEL_DIR=$HOME/rog-pc/models

# ---- 两个窗是两回事，别混（asr.py 文件头有详细说明）----
# (1) **切分的窗**：音频在哪里断开送给 whisper。**不按固定长度切**。
export ASR_SILENCE_SEC=0.6         # 静音连续这么久 = 一句话说完了
export ASR_MIN_SPEECH_SEC=0.4      # 比这短的声音不当发话，丢掉
export ASR_MAX_SEGMENT_SEC=8       # 一直说不停时的强制断点
# (2) **上下文的窗**：给 VLM 看多长的转写。改了要重起 run_asr.sh。
export ASR_CONTEXT_SEC=60
# 内存里留多久的发话。比上下文窗长得多是故意的：窗还要调，留长一点才能在
# 同一次运行里比较不同的值。
export ASR_KEEP_SEC=600

# **和 ROG_PYTHON 是两个环境**：ctranslate2 要 CUDA 12 的 cudnn，
# 而那边的 torch 是 cu130。建法见 README「环境」。
export ASR_PYTHON=$HOME/rog-pc/venv-asr/bin/python3

# ---- 转写的 HTTP 出口（架构 §3.1）----
# **绑 0.0.0.0 不是 tailscale 地址** —— 那个地址要等 tailscale 起来才有，
# 绑死的话 tailscale 没起这个服务就起不来。
export ASR_HTTP_HOST=0.0.0.0
export ASR_HTTP_PORT=8770

# ---- recv.py 的视频缓冲 ----
# **这台机器用不上**（ASR 只收音频），但 recv.py 和 vlm-server 那份要保持
# 逐字节一致，而它一律读这两个键。留着，值无所谓。
export BUFFER_SEC=0
export BUFFER_FPS=0
