# =============================================================
# tele-server 的配置。上一层的 run_tele.sh 会 source 它。
#
# **这里是配置的唯一出处。** 脚本和代码里不写默认值，未设置就在启动时报错退出。
#
# 旧实现分成 common/config.env ＋ pc-c-operator/config.env 两层，
# `common/` 那一层随四机结构一起没了 —— 现在每个服务一份，就这一个。
# =============================================================

export UI_PORT=7779
# Flask 的会话密钥。**不是门禁** —— 这个页面没有认证（见下面 UI_BIND）。
export UI_SECRET=p32-teleop

# ---- 绑哪个地址 ----
# **tele-pc 要能打开，所以绑 0.0.0.0。** 代价是这个页面没有认证
# （UI_SECRET 是 Flask 的会话密钥，不是门禁），同一个 AP 上谁打开都能开车。
# 现场是封闭的 AP，暂按可接受处理。
#
# 只想在 rog-server 本机试页面的话填 127.0.0.1。
export UI_BIND=0.0.0.0

# ---- 页面里那个 OME 的地址 ----
# **这是给浏览器用的，不是给本进程用的。** 浏览器在 tele-pc 上，所以要写
# rog-server 的名字。stream-server 自己的 config.env 里 OME_HOST 是 127.0.0.1，
# 那是本机拉流用的 —— 两个不是一回事，别混。
# 解析不了就填 192.168.1.10（架构 §0.1）。
export OME_HOST_BROWSER=rog-server.local
export OME_WS_PORT=3333
export OME_APP=app
# 取哪两条流。要和 robot-pc 推上去的一致，对不上的表现是「页面出来了但没画面」。
export STREAM_KEY_FISHEYE=fisheye
export STREAM_KEY_SOUNDMAP=soundmap

# ---- 操作指令 ----
# ROS 那半的总开关。**0 = 只发页面，指令不发出去** —— 先调画面那半的时候用，
# 也是现在的默认值：**整条操作指令通路还没设计**（架构文档开头把它划在范围外），
# 所以这条链现在只有「UI → ROS」这一段是现成的，机体那一侧还没接。
export UI_ROS_ENABLE=0
# 机体名。要和 robot-pc / stream-server 的一致。
export ROBOT_NAME=boxie
# ROS 域号。**两台机器必须一致**（架构 §7.1）。
export ROS_DOMAIN_ID=32
export ROS_SETUP=/opt/ros/jazzy/setup.bash

# ---- ★ 手臂 ----
# **现在必须是 0。** 旧实现用 audio_common_msgs/BoxieMotors 发手臂角度，
# 那个类型来自旧实现搬来的第三方消息包，新结构里没有（teleop_msgs 只有记录用
# 的四个类型）。置 1 会在启动时明确报错告诉你缺什么，而不是按下按钮才发现
# 什么都没发生。等操作指令通路定下来，连消息类型一起定。
export ARM_ENABLE=0
export ARM_UP_DEG=60
export ARM_DOWN_DEG=0

# ---- 日志 / Python ----
export LOG_DIR=$HOME/rog-pc/log
# **和 ROG_PYTHON、ASR_PYTHON 都不是一个。** 这个只要 flask ＋ flask-socketio
# ＋ rclpy，不要 torch，也不要 faster-whisper。建法见 README「环境」。
export TELE_PYTHON=$HOME/rog-pc/venv-tele/bin/python3
