# =============================================================
# tele-server 的配置。上一层的 run_tele.sh 会 source 它。
# **配置的唯一出处**，脚本和代码里不写默认值，未设置就报错退出。
# =============================================================

export UI_PORT=7779
export UI_SECRET=teleop-session     # Flask 的会话密钥。**不是门禁**

# **tele-pc 要能打开，所以绑 0.0.0.0。** 只想在 rog-server 本机试页面就填 127.0.0.1。
export UI_BIND=0.0.0.0

# ---- 页面里那个 OME 的地址 ----
# **这是给浏览器用的，不是给本进程用的。** 浏览器在 tele-pc 上，所以要写
# rog-server 的名字 —— stream-server 自己的 config.env 里 OME_HOST 是
# 127.0.0.1，那是本机拉流用的，两个别混。解析不了就填 192.168.1.10。
export OME_HOST_BROWSER=rog-server.local
export OME_WS_PORT=3333
export OME_APP=app
# 页面取哪两条流。对不上的表现是「页面出来了但没画面 / 没声音」。
#   rgb_sm      鱼眼 ＋ 声音图，stream-server 已经叠好（**纯视频，没有音轨**）
#   onboardmic  机体麦克风，robot-pc 直推的纯音频流
export STREAM_KEY_VIEW=rgb_sm
export STREAM_KEY_ONBOARDMIC=onboardmic

# ---- 操作指令 ----
# ROS 那半的总开关。**0 = 只发页面，指令不发出去**（先单独调画面那半时用）。
export UI_ROS_ENABLE=1
export ROBOT_NAME=boxie             # 要和 robot-pc / stream-server 的一致
export ROS_DOMAIN_ID=32             # **两台机器必须一致**
export ROS_SETUP=/opt/ros/jazzy/setup.bash

# ---- ★ 手臂 ----
# **现在必须是 0。** 手臂角度原本用 audio_common_msgs/BoxieMotors，
# 新结构里没有这个类型（teleop_msgs 只有记录用的四个）。置 1 会在**启动时**
# 明确报错告诉你缺什么，而不是按下按钮才发现什么都没发生。
export ARM_ENABLE=0
export ARM_UP_DEG=60
export ARM_DOWN_DEG=0

# ---- 日志 / Python ----
export LOG_DIR=$HOME/rog-pc/log
# **和 ROG_PYTHON、ASR_PYTHON 都不是一个。** 只要 flask ＋ flask-socketio
# ＋ rclpy，不要 torch 也不要 faster-whisper。建法见 README「环境」。
export TELE_PYTHON=$HOME/rog-pc/venv-tele/bin/python3
