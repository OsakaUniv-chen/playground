# =============================================================
# PC-B（ロボット miniPC）固有の設定
# ★ は現地でデバイスを繋いでから確認して埋める
# 確認方法は todo-list.md の「pc-b-robot/config.env」
# =============================================================

# ---- Xacti カメラ（CX-MT500）★ デバイスパスは現地で確認 ----
export CAM_DEVICE=/dev/video0

# ---- 16ch マイクアレイ（miniDSP UMA16v2、実機で確認済み）----
# UMA16v2 は MMAP_INTERLEAVED / RW_INTERLEAVED のみ。planar は取れないので
# 並びは interleaved 固定（切り替える余地が無いため設定項目にしていない）。
export MIC_ARRAY_DEVICE=hw:CARD=UMA16v2,DEV=0

# ---- 機体マイク / スピーカー ★ ----
export ONBOARD_MIC_DEVICE=default
export SPEAKER_DEVICE=default

# ---- Keigan ALI（台車）★ ----
export ALI_MQTT_HOST=192.168.4.2
export ALI_MQTT_PORT=9075

# ---- Keigan モータの BLE アドレス（頭部 3 + 腕 2）★ ----
# `sudo hcitool lescan` か、既存 boxie_node（~/ros2_ws）の motor_defs から取る。
# 下の値は実機から写したもの。モータを交換したらここを直す。
export ADDR_HEAD_PITCH=f1:ae:4f:c1:57:c0
export ADDR_HEAD_YAW=cd:93:a4:6f:be:9b
export ADDR_HEAD_ROLL=ec:64:f6:ba:ca:7e
export ADDR_LEFT_ARM=c5:0b:cb:17:b4:a5
export ADDR_RIGHT_ARM=e5:c6:61:06:da:8f

# ---- 収録 ----
# 配置先（~/p32/common と ~/p32/pc-b-robot）と同じ木の下に置く。
# record.sh が起動時に mkdir -p するので、先に作っておかなくてよい。
# **配置先を ~/p32 以外にしたらここも直す。** 相対で書いていないのは、
# この値を組み立てる時点では env.sh がまだ PCB_DIR を export していないため。
# rsync で配り直しても消えない（配るのは common/ と pc-b-robot/ だけ）。
export RECORD_DIR=$HOME/p32/rosbags
export BAG_SPLIT_MB=2048
