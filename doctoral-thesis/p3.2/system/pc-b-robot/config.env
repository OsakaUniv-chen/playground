# =============================================================
# PC-B（ロボット miniPC）固有の設定
# ★ は現地でデバイスを繋いでから確認して埋める
# 確認方法は todo-list.md の「pc-b-robot/config.env」
# =============================================================

# ---- Xacti カメラ（CX-MT500）----
# **名前で引く。** `/` で始まらない値はカメラの名前として扱い、cam_bridge が
# /sys/class/video4linux/*/name を走査して /dev/videoN に解決する。
# /dev/videoN の番号は USB の列挙順で変わる ── 挿し直しただけ、他の USB 機器を
# 足しただけでずれるので、番号を直接書かない。
#
# **この名前は確認済み。** 沿用元の camera_node.py（~/ros2_ws）が同じ sysfs の
# name を `split(':')[0]` して `'CX-MT500'` と完全一致で引いており、実機で
# 外したことがない。つまり生の name は `CX-MT500: ...` の形。こちらは部分一致
# なので、その形でも `Xacti CX-MT500` のような形でも拾える。
#
# 別のカメラに替えたら、その名前をここに書く。確認は
#     cat /sys/class/video4linux/*/name        （または v4l2-ctl --list-devices）
# どうしても固定したいときだけ /dev/video0 のような絶対パスを書く（素通しになる）。
export CAM_DEVICE=CX-MT500

# ---- 16ch マイクアレイ（miniDSP UMA16v2、実機で確認済み）----
# こちらも名前で引いている（ALSA の `hw:CARD=<名前>` 形式）。ALSA は
# カード名指定を標準で持つので、カメラのような解決処理は要らない。
# UMA16v2 は MMAP_INTERLEAVED / RW_INTERLEAVED のみ。planar は取れないので
# 並びは interleaved 固定（切り替える余地が無いため設定項目にしていない）。
export MIC_ARRAY_DEVICE=hw:CARD=UMA16v2,DEV=0

# ---- 機体マイク / スピーカー ★ 機種が未定。決まったら名前を書く ----
# **`default` は仮置き。** ALSA の `default` は「そのとき系のシステム既定に
# なっているカード」で、USB オーディオを 1 本挿し替えるだけで別の機器に移る。
# しかもエラーは出ず、**別のマイクから録れて別のスピーカーから鳴る**という
# 形で外れるので、現地で気付きにくい。
#
# 機種が決まったら、アレイと同じ `hw:CARD=<名前>` 形式で固定する:
#     export ONBOARD_MIC_DEVICE=hw:CARD=<名前>,DEV=0
#     export SPEAKER_DEVICE=hw:CARD=<名前>,DEV=0
#
# <名前> の調べ方 ── `arecord -l`（録音）/ `aplay -l`（再生）を叩くと
#     card 2: Device [USB PnP Sound Device], device 0: ...
# のように出る。角括弧の中ではなく **`card N:` の直後の短い名前**が
# `hw:CARD=` に書く値（この例なら `Device`）。`cat /proc/asound/cards` でも同じ。
#
# 名前を決めたら、対応レートも合わせて確認して common/config.env の
# ONBOARD_MIC_RATE / _CHANNELS を直す（合っていないと caps 交渉に失敗して
# パイプラインが起動しない）:
#     arecord -D hw:CARD=<名前>,DEV=0 --dump-hw-params
export ONBOARD_MIC_DEVICE=default
export SPEAKER_DEVICE=default

# ---- Keigan ALI（台車）★ 現場ごとに変わる ----
# rover_driver が Twist を 8 方向に量子化して、この broker の `control/joy` へ
# JSON で投げる。**下の値は沿用元（indy 側の機械）のもので、こちらの ALI で
# 同じとは限らない。** 現場で変わるのが前提なので、変えるのはこの 2 行だけで
# 済むようにしてある（コード側に既定値は無い）。
#
# 確認の手順:
#   1. ALI と同じ LAN に居るか      ping <ALI の IP>
#   2. broker がその機械で開いているか
#          nc -vz <IP> 9075          （または `ss -lntp | grep 9075` を ALI 上で）
#   3. 指令が通るか
#          mosquitto_sub -h <IP> -p 9075 -t 'control/#' -v
#      を出しておいて、操作画面のスティックを倒す。`control/joy {"data":N}`
#      が流れれば経路は生きている（N は 0=停止, 1=前, 3=左 … の 8 方向）。
#
# broker が ALI 本体で動くのか別に立てるのかは未確定（todo-list.md）。
# 速度上限は **ALI 側の設定で絞る** ── 離散 8 方向なのでこちらでは効かない。
export ALI_MQTT_HOST=192.168.4.2
export ALI_MQTT_PORT=9075

# ---- Keigan モータの BLE アドレス（頭部 3 + 腕 2）★ ----
# `sudo hcitool lescan` か、既存 boxie_node（~/ros2_ws）の motor_defs から取る。
# 下の値は実機から写したもの。モータを交換したらここを直す。
export ADDR_HEAD_PITCH=f1:ae:4f:c1:57:c0
export ADDR_HEAD_YAW=cd:93:a4:6f:be:9b
export ADDR_HEAD_ROLL=ec:64:f6:ba:ca:7e
export ADDR_LEFT_ARM=c5:0b:cb:17:b4:a5
export ADDR_RIGHT_ARM=e5:c6:61:06:da:8f

# ---- 収録 ----
# 配置先（~/p32/common と ~/p32/pc-b-robot）と同じ木の下に置く。
# record.sh が起動時に mkdir -p するので、先に作っておかなくてよい。
# **配置先を ~/p32 以外にしたらここも直す。** 相対で書いていないのは、
# この値を組み立てる時点では env.sh がまだ PCB_DIR を export していないため。
# rsync で配り直しても消えない（配るのは common/ と pc-b-robot/ だけ）。
export RECORD_DIR=$HOME/p32/rosbags
export BAG_SPLIT_MB=2048
