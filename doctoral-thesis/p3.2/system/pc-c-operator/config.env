# =============================================================
# PC-C（操作者端末）固有の設定
# =============================================================
export UI_PORT=7779
export UI_SECRET=p32-teleop

# ---- 操作者マイク ★ 機種が未定。決まったら名前を書く ----
# **内蔵マイクは使わない。** `default` のままだと系のシステム既定、つまり
# 本体内蔵（ALC285 Analog）が選ばれる。操作者はヘッドセットで喋る前提なので、
# PC-B と同じく `hw:CARD=<名前>` で固定する:
#
#     export OPERATOR_MIC_DEVICE=hw:CARD=<名前>,DEV=0
#
# <名前> の調べ方 ── ヘッドセットを挿してから `arecord -l` を叩くと
#     card 2: Headset [Jabra Evolve 20], device 0: USB Audio [USB Audio]
# のように出る。角括弧の中ではなく **`card N:` の直後の短い名前**が
# `hw:CARD=` に書く値（この例なら `Headset`）。`cat /proc/asound/cards` でも同じ。
#
# `default` を避ける理由は PC-B の機体マイクと同じ ── USB オーディオを 1 本
# 挿し替えるだけで指す先が黙って移り、**別のマイクから拾っているのにエラーは
# 出ない。** 名前で固定すれば、その機器が無いときは起動時に落ちる。
#
# **マイクは常時オン**（PTT は無い）。`./run.sh` を上げた時点から、この
# デバイスの音がそのまま機体のスピーカーへ流れ続ける。
export OPERATOR_MIC_DEVICE=default

# ---- PC-D（理研）との接続 ★ ----
# PC-D は Tailscale で同じ tailnet に居る。**PC-C がハブ**で、PC-D は
# PC-C としか通信しない（PC-B は同じ LAN なので Tailscale は要らない）。
#
# 頭部指令の中継を待ち受けるアドレス。PC-D から届く必要があるので
# tailscale のアドレスにする。`tailscale ip -4` で確認。
# 0.0.0.0 にすると LAN 側からも入れるので、絞れるならこちらを書く。
export HEAD_RELAY_BIND=100.80.23.31
