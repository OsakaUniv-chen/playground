# =============================================================
# PC-C（操作者端末）固有の設定
# =============================================================
export UI_PORT=7779
export UI_SECRET=p32-teleop

# ---- 操作者マイク ★ ----
export OPERATOR_MIC_DEVICE=default

# ---- PC-D（理研）への SSH トンネル ★ ----
# ~/.ssh/config の Host 名を書くと run.sh がトンネルを張る。
# 空にすると張らない（PC-D が同じ LAN に居る場合）。
#   Host 3090PC / HostName 192.168.3.68 / ProxyJump Riken
export PCD_SSH_HOST=3090PC
