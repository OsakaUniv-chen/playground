# =============================================================
# robot-pc 的配置。start_gstreamer.sh 会 source 这个文件。
# =============================================================

# ---- stream-server 上的 OME ----
# 四条传感器流往这里推（SRT），操作者语音从这里拉（WebRTC）。
# **进 OME 一律 SRT，出 OME 一律 WebRTC**（system-architecture.md §1.2）。
# **★ 用名字，解析不了就填 IP。** rog-server 的 mDNS 名，avahi 提供。
# 解析不了（robot-pc 上没装 nss-mdns、或者 AP 挡了 mDNS 的组播）就直接填
# 192.168.1.10 —— 那是它的静态地址。表现是 srtsink 一起来就报名字解析失败，
# 然后被重连循环无限重试，状态面板上看得到。
export OME_HOST=rog-server.local
export OME_SRT_PORT=9999
# WebRTC 的 signalling 端口。只有 speaker.py（下行）用得着。
export OME_WS_PORT=3333
export OME_VHOST=default
export OME_APP=app

# SRT 的延迟上限 [ms]。局域网内 20 就够；链路变差就往上调。
export SRT_LATENCY=20

# stream key。上行四条 —— 这台机器推出去的。
export KEY_FISHEYE=fisheye
export KEY_SOUNDMAP=soundmap
export KEY_REALSENSE=realsense
export KEY_NAVCAM=navcam
# 下行一条 —— 操作者那台推进 OME，这台机器拉下来放。名字要和推的那边
# 一致（架构文档 §4.2：AAC 48 kHz 1ch，SRT 进 OME）。对不上的表现是
# 「signalling 通了但永远没有声音」。
export KEY_OPERATORMIC=operatormic

# ---- 鱼眼相机 Xacti CX-MT500 ----
# **按名字引用。** 不以 / 开头的值当作相机名字，脚本会扫
# /sys/class/video4linux/*/name 解析成 /dev/videoN。
# /dev/videoN 的编号随 USB 枚举顺序变，重插一次就会错位。
# 这个名字沿用旧实现（实机上 name 形如 `CX-MT500: ...`），是部分匹配。
export CAM_FISHEYE_NAME=CX-MT500
# 相机只出 MJPG，从设备取 1920×1080 后裁中央 1080×1080（左右各丢 420 px）。
# 裁切位置和旧实现的 img[:, 420:1500] 一致，有实绩。
export FISHEYE_SRC_WIDTH=1920
export FISHEYE_SRC_HEIGHT=1080
export FISHEYE_CROP_LEFT=420
export FISHEYE_CROP_RIGHT=420
export FISHEYE_FPS=30
export FISHEYE_BITRATE=5000        # kbps
# 相机倒装，要转 180 度。换了安装方向才改成 0。
export FISHEYE_ROTATE_180=1

# ---- RealSense（**只取 color**）----
# depth 不打开。原始 16-bit depth 有 195 Mbps，开了整个存储方案都得重做。
# RealSense 一个设备会挂出好几个 video 节点（color / depth / IR / metadata），
# 光靠名字分不出来，所以脚本还会检查节点支不支持下面这个像素格式。
export CAM_REALSENSE_NAME=RealSense
export REALSENSE_FORMAT=YUY2        # ★ 用 v4l2-ctl --list-formats-ext 确认
export REALSENSE_WIDTH=848
export REALSENSE_HEIGHT=480
export REALSENSE_FPS=30
export REALSENSE_BITRATE=4000       # kbps

# ---- 导航相机 ----
export CAM_NAVCAM_NAME=HCVsight     # ★ 换了相机就改这里
export NAVCAM_FORMAT=MJPG           # ★ MJPG 或 YUY2，用 v4l2-ctl 确认
export NAVCAM_WIDTH=1280
export NAVCAM_HEIGHT=720
export NAVCAM_FPS=30
export NAVCAM_BITRATE=3000          # kbps

# ---- 机体麦克风 / 扬声器 audio-technica AT-CSP1 ----
# USB 会议扬声器（スピーカーフォン）。一张 USB 声卡上同时挂着录音和放音，
# 所以下面这两个名字指的是同一台设备。
#
# **按名字引用，不写 hw:2 这种编号**，理由和相机一样：编号随 USB 枚举顺序变。
# 名字是**部分匹配**，脚本拿它去比 /proc/asound/cards 的两行（方括号里的卡 id
# 和后面的产品名），命中了再拼成 hw:CARD=<id>,DEV=0。
# 填 CSP1 而不是 AT-CSP1：卡 id 是内核把 USB 产品名里的非字母数字去掉生成的
# （AT-CSP1 -> ATCSP1），和包装上印的不一样，而 CSP1 两边都能命中。
#
# **不要用 default。** default 指的是当时的系统默认声卡，插拔一个 USB 音频
# 设备就会静默地换成别的，而且不报错 —— 现场发现不了。
export ONBOARD_MIC_NAME=CSP1
# 放音（speaker.py）**必须也用这台设备** —— AT-CSP1 自带硬件回声消除，操作者的
# 声音从它自己放出去才不会被机体麦克风收回去；换个别的喇叭放，回声消除就不认识
# 那路信号了。
export SPEAKER_NAME=CSP1
# 收操作者语音的抖动缓冲 [ms]（webrtcbin 的 jitterbuffer）。这是对话链路，
# 宁可短一点：网络抖动时丢音比整段延后好。
export SPEAKER_JITTER_MS=100
# AT-CSP1 的 USB 音频规格（厂商 spec）：48 kHz、最大 16 bit，麦克风是一颗
# 360° 无指向电容式 => 录音是单声道。48k 进 AAC 正好不用重采样。
# 换了别的设备就用 `arecord -D hw:CARD=<id>,DEV=0 --dump-hw-params` 重查；
# 对不上的时候 fisheye 窗口会打一行 ★（实际声道数从 /proc/asound 读，
# 不用打开设备）。
export ONBOARD_MIC_CHANNELS=1
export ONBOARD_MIC_RATE=48000
# AAC bps。AT-CSP1 的麦克风频响就是 100-10k Hz 这段语音带，64k 够用。
export ONBOARD_MIC_BITRATE=64000

# ---- 声音图的发送 ----
# 生成参数在 soundmap.py 里。这里只有出口。
export SOUNDMAP_BITRATE=500         # kbps。64×64 这个够用还有富余

# ---- 编码器 ----
# 1 = 优先用核显（VA-API）。**目的不是提速而是腾 CPU** —— robot-pc 要同时跑
# 3 路编码、声音图生成和 bag 写入，软解 MJPG + x264 会吃掉 1.5～2 个核。
# 缺 vaapi element 时脚本自动退回软件，所以这个值填错也能起来（启动日志会说
# 实际用的哪个）。
export USE_HW_CODEC=1

# ---- 有没有接硬件 ----
# 0 = 打开真实设备（**机体上用这个**，默认）
# 1 = 换成 videotestsrc / audiotestsrc，在没接传感器的桌子上验证链路
#
# 换掉的**只有设备那一头**。编码、SRT、OME 这些一个都不少，所以测出来的
# 链路是真的。默认给 0 是因为：现场忘了改也能正常工作；反过来的话，会把
# 一整场活动录成粉红噪声和弹跳球，而日志、帧率、文件大小看着全都正常。
export USE_FAKE_SOURCES=0

# ---- tmux ----
# 脚本把所有东西跑在这个 tmux session 里，好处有两个：
#   1. 用 ssh 起的话，断线不会把机器人的推流一起带走
#   2. 别的机器 `ssh <robot-pc>` 之后 `tmux attach -t <这个名字>` 就能看状态
export TMUX_SESSION=boxie_gst
# 状态面板的刷新间隔 [s]
export STATUS_INTERVAL=2

# ---- 断线重连 ----
# srtsink 连不上会直接退出（OME 没起、名字解析不了、网络瞬断都算）。
# 脚本给每条流套了重连循环，所以**起动顺序无所谓** —— 机体可以先于 OME 起来。
export RESTART_SEC=5

# ---- 数据看门狗 ----
# 上面那个重连循环只认「进程退出」。**USB 抽风、驱动卡死的时候进程不退出** ——
# 管线停在 PLAYING，一个 buffer 都不再流动，日志、帧率、文件大小看着全都正常，
# 而实际上什么都没送出去。
#
# 办法：**每个进程自己盯自己** —— cam.py 在 srtsink 那一端挂 pad probe 数出去的
# 包，多久没动就写一个 <名字>.stalled 记号再退出，交给重连循环重起（重起时重新
# 解析设备，USB 重新枚举完能接回来）。start_gstreamer.sh 只按那个记号把「卡死」
# 和「重连」分成两列记账。
# 下面这两个只管 cam.py 那三条；声音图不走这套，它自己数进来的音频
# （见 soundmap.py 的 INPUT_TIMEOUT_MS），speaker.py 和 recorder.py 不盯。
#
# 检查周期 [s]。0 = 关掉（面板上会红字提示）。
export STALL_CHECK_SEC=5
# 连着这么多次没有新数据就判死。5 x 3 = 15 s：比相机重新枚举 + 吐出第一帧的
# 1~2 s 宽裕得多，不会误杀；反过来说现场最多黑 15 秒。
export STALL_MISSES=3

# ---- 记录（架构文档 §6）----
# 1 = 各进程同时把数据发给 recorder，并多起一个 recorder 窗口。
# 0 = 只推流，**完全不碰 ROS**（没装 ROS 的机器上照样能跑全部推流）。
export RECORD_ENABLE=1
# ★ ROS 和放 teleop_msgs 的 workspace。RECORD_ENABLE=1 时 start_gstreamer.sh 会
# 自动 source 这两个 —— 忘了 source 的表现是进程一起来就 ImportError，
# 然后被重连循环无限重试。distro 不是 humble 就改这里（跑 ./setup.sh 会告诉你）。
export ROS_SETUP=/opt/ros/humble/setup.bash
export ROS_WS_SETUP=$HOME/robot-pc/ws/install/setup.bash
# ROS 那半。录进 bag 的 topic 都在 /<ROBOT_NAME>/ 底下，**这个名字要和
# stream-server 的 config.env 一致** —— 对不上的表现是 trigger 永远收不到，
# 于是一直在 fail-open 连续录（磁盘会被吃光，但不会没录到）。
export ROBOT_NAME=boxie
# ROS 的域号。**0 是所有人的默认值** —— 同一个 LAN 上别人的 ROS 节点会和
# 我们互相发现，topic 撞名、trigger 被别的东西盖掉都可能。32 取自 P3.2，
# 好记又不常用。**两台机器必须一致**（robot-pc / rog-pc），
# 对不上的表现是 robot-pc 永远收不到 trigger，于是一直 fail-open 连续录。
export ROS_DOMAIN_ID=32

# 录到哪。**要放在够大的盘上** —— 录制期间约 27 Mbps ≈ 12 GB/小时
# （其中 16ch 阵列原始 S16LE 就占 11.3 Mbps；只在有人时录，按 20% 占空比
# 算实际约 2.4 GB/墙钟小时）。
export RECORD_DIR=$HOME/robot-pc/bag
# 剩余空间低于这个就不开新的 bag [GB]（已经在录的那个不打断）。
export RECORD_MIN_FREE_GB=20

# 存储格式。mcap 要装 ros-$ROS_DISTRO-rosbag2-storage-mcap；没装的机器上
# 填 sqlite3 也能跑（Foxglove / rosbag2 一样认，只是文件大一些）。
export BAG_STORAGE=mcap
# 内部切片大小 [MB]。**一次录制仍然是一个目录** —— 切片只是为了崩溃时
# 最多丢末尾一片，任何读取端都把整个目录当成一段连续记录。
export BAG_SPLIT_MB=2048

# 前录 / 后录 [s]。前录靠内存环形缓冲（27 Mbps × 10 s ≈ 34 MB）。
# 前录不能太短：判断走完「编码->SRT->OME->WebRTC->推理」再送回来已经旧了
# 0.2~0.5 s，加上判定迟滞最坏约 3 s，都得由它吸收。
export PREROLL_SEC=10
export POSTROLL_SEC=15
# 多久收不到 trigger 就切成**连续录**（fail-open）[s]。
# stream-server 挂了、LAN 断了、检测节点卡死了 —— 哪种都一样，
# 「悄无声息地什么都没录到」是最坏的结果，所以宁可多录。
export TRIGGER_TIMEOUT_SEC=3

# ---- 日志 ----
export LOG_DIR=$HOME/robot-pc/log
