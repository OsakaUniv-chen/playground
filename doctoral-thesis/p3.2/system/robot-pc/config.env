# =============================================================
# robot-pc 的配置。start_gstreamer.sh 会 source 这个文件。
# 设计见 ../system-architecture.md，这里只说每一项填什么、怎么查。
# =============================================================

# ---- stream-server 上的 OME ----
# ★ 用名字，解析不了就直接填 192.168.1.10（rog-server 的静态地址）。
#   解析不了的表现是 srtsink 一起来就报名字解析失败，然后被重连循环无限重试。
export OME_HOST=rog-server.local
export OME_SRT_PORT=9999
export OME_WS_PORT=3333             # WebRTC signalling。只有 speaker.py 用
export OME_VHOST=default
export OME_APP=app

export SRT_LATENCY=20               # SRT 延迟上限 [ms]。链路变差就往上调

# ---- stream key ----
# 上行五条。onboardmic 和 fisheye 里那路音频是同一次编码，tee 分出来的。
export KEY_FISHEYE=fisheye
export KEY_SOUNDMAP=soundmap
export KEY_REALSENSE=realsense
export KEY_NAVCAM=navcam
export KEY_ONBOARDMIC=onboardmic
# 下行一条。**名字要和 tele-pc 推的那边一致**，对不上的表现是
# 「signalling 通了但永远没有声音」。
export KEY_OPERATORMIC=operatormic

# ---- 鱼眼相机 Xacti CX-MT500 ----
# **按名字引用**（不以 / 开头的值当作名字，脚本扫
# /sys/class/video4linux/*/name 解析成 /dev/videoN）。是部分匹配。
export CAM_FISHEYE_NAME=CX-MT500
export FISHEYE_SRC_WIDTH=1920
export FISHEYE_SRC_HEIGHT=1080
export FISHEYE_CROP_LEFT=420        # 裁中央 1080×1080，等价于 img[:, 420:1500]
export FISHEYE_CROP_RIGHT=420
export FISHEYE_FPS=30
export FISHEYE_BITRATE=5000         # kbps
export FISHEYE_ROTATE_180=1         # 相机倒装。换了安装方向才改成 0

# ---- RealSense（只取 color）----
# 一个设备会挂出好几个 video 节点（color / depth / IR / metadata），光靠名字
# 分不出来，所以脚本还会检查节点支不支持下面这个像素格式。
export CAM_REALSENSE_NAME=RealSense
export REALSENSE_FORMAT=YUY2        # ★ 用 v4l2-ctl --list-formats-ext 确认
export REALSENSE_WIDTH=848
export REALSENSE_HEIGHT=480
export REALSENSE_FPS=30
export REALSENSE_BITRATE=4000       # kbps

# ---- 导航相机 ----
export CAM_NAVCAM_NAME=HCVsight     # ★ 换了相机就改这里
export NAVCAM_FORMAT=MJPG           # ★ MJPG 或 YUY2，用 v4l2-ctl 确认
export NAVCAM_WIDTH=1280
export NAVCAM_HEIGHT=720
export NAVCAM_FPS=30
export NAVCAM_BITRATE=3000          # kbps

# ---- 机体麦克风 / 扬声器 audio-technica AT-CSP1 ----
# 一张 USB 声卡上同时挂着录音和放音，所以下面两个名字指的是同一台设备。
#
# **按名字引用，不写 hw:2 这种编号。** 名字是**部分匹配**，脚本拿它去比
# /proc/asound/cards 的两行（方括号里的卡 id 和后面的产品名）。
# 填 CSP1 而不是 AT-CSP1：卡 id 是内核把 USB 产品名里的非字母数字去掉生成的
# （AT-CSP1 -> ATCSP1），和包装上印的不一样，而 CSP1 两边都能命中。
# **不要用 default** —— 它指当时的系统默认声卡，插拔一个 USB 音频设备就会
# 静默地换成别的，而且不报错。
export ONBOARD_MIC_NAME=CSP1
# 放音**必须也用这台设备**：AT-CSP1 自带硬件回声消除，换个别的喇叭放，
# 回声消除就不认识那路信号了。
export SPEAKER_NAME=CSP1
export SPEAKER_JITTER_MS=100        # 收操作者语音的抖动缓冲 [ms]
# AT-CSP1 的厂商 spec：48 kHz / 16 bit / 单声道。换了设备用
# `arecord -D hw:CARD=<id>,DEV=0 --dump-hw-params` 重查；对不上时 fisheye
# 窗口会打一行 ★（实际声道数从 /proc/asound 读，不用打开设备）。
export ONBOARD_MIC_CHANNELS=1
export ONBOARD_MIC_RATE=48000
export ONBOARD_MIC_BITRATE=64000    # AAC bps
# 采集／放音增益（gst 的 `volume` element，1.0 = 原样）。
# **不是 pactl 的音量** —— 管线用 `hw:CARD=` 直接开 ALSA，绕过 PulseAudio，
# pactl 那套对这条链路无效。AT-CSP1 电平偏低，实测取 4.0 / 2.0。
export ONBOARD_MIC_GAIN=4.0
export SPEAKER_GAIN=2.0

# ---- 声音图的发送 ----
# 生成参数在 soundmap.py 里，这里只有出口。
export SOUNDMAP_BITRATE=500         # kbps

# ---- 编码器 ----
# 1 = 优先用核显（VA-API）。缺 vaapi element 时自动退回软件，所以填错也能起来
# （启动日志会说实际用的哪个）。
export USE_HW_CODEC=1

# ---- 有没有接硬件 ----
# 0 = 打开真实设备（**机体上用这个**）。1 = 换成 videotestsrc / audiotestsrc，
# 只换设备那一头，编码和 SRT 还是真的。
# **默认必须是 0** —— 填成 1 会把一整场活动录成粉红噪声和弹跳球，而日志、
# 帧率、文件大小看着全都正常。
export USE_FAKE_SOURCES=0

# ---- tmux ----
export TMUX_SESSION=boxie_gst
export STATUS_INTERVAL=2            # 状态面板刷新间隔 [s]

# ---- 断线重连 ----
export RESTART_SEC=5                # 进程退出后隔多久重起 [s]

# ---- 数据看门狗 ----
# 只管 cam.py 那三条。声音图看 soundmap.py 的 INPUT_TIMEOUT_MS，
# speaker.py 和 recorder.py 不盯。
export STALL_CHECK_SEC=5            # 检查周期 [s]。0 = 关掉（面板红字提示）
# 连着这么多次没有新数据就判死。5 × 3 = 15 s：比相机重新枚举 + 吐出第一帧的
# 1~2 s 宽裕得多，不会误杀；反过来说现场最多黑 15 秒。
export STALL_MISSES=3

# ---- 记录（架构 §6）----
# 1 = 各进程同时把数据发给 recorder，并多起一个 recorder 窗口。
# 0 = 只推流，**完全不碰 ROS**（没装 ROS 的机器上照样能跑全部推流）。
export RECORD_ENABLE=1
# ★ ROS 和放 teleop_msgs 的 workspace。RECORD_ENABLE=1 时会自动 source 这两个
# —— 忘了 source 的表现是进程一起来就 ImportError，然后被重连循环无限重试。
# distro 不是 humble 就改这里（跑 ./setup.sh 会告诉你）。
export ROS_SETUP=/opt/ros/humble/setup.bash
export ROS_WS_SETUP=$HOME/robot-pc/ws/install/setup.bash
# **要和 stream-server 的 config.env 一致。** 对不上的表现是 trigger 永远收不到，
# 于是一直在 fail-open 连续录（磁盘会被吃光，但不会没录到）。
export ROBOT_NAME=boxie
# **两台机器必须一致**，对不上同样是一直 fail-open。不用 0：那是所有人的默认值，
# 同一个 LAN 上别人的 ROS 节点会和我们互相发现。
export ROS_DOMAIN_ID=32

export RECORD_DIR=$HOME/robot-pc/bag    # ★ 要放在够大的盘上，约 12 GB/录制小时
export RECORD_MIN_FREE_GB=20            # 低于这个就不开新 bag（在录的不打断）
# mcap 要装 ros-$ROS_DISTRO-rosbag2-storage-mcap；没装的机器上填 sqlite3 也能跑
# （Foxglove / rosbag2 一样认，只是文件大一些）。
export BAG_STORAGE=mcap
export BAG_SPLIT_MB=2048            # 一个录制区间内部的分片大小 [MB]

export PREROLL_SEC=10               # 前录 [s]，靠内存环形缓冲（≈ 34 MB）
export POSTROLL_SEC=10              # 后录 [s]
export TRIGGER_TIMEOUT_SEC=3        # 多久收不到 trigger 就切成连续录（fail-open）

# ---- 日志 ----
export LOG_DIR=$HOME/robot-pc/log
