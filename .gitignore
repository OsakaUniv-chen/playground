__pycache__/
*.pyc
.DS_Store

# model checkpoints — never commit, regardless of path (see CLAUDE.md: no files >10MB)
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# videos — never commit, regardless of path
*.mp4

# PSSP: preprocessing-generated training data, never commit -- large,
# regeneratable from the raw rosbags (see train-pssp/CONTEXT.md).
*.npz
*.npy

# generated data tables — never commit, regenerable from raw data
*.parquet

# PSSP: training run outputs (checkpoints/logs/plots), regenerable by rerunning
train-pssp/*-run/train/runs/

# P6 VLM probe images (input soundmaps / QC / result plots) — large, regeneratable
# from raw data; keep the probe code + manifest, not the images.
p6/try-VLM/**/*.png
p6/try-VLM/**/*.jpg
p6/try-VLM/**/*.jpeg

# P6 try-VLM-server sample images (mode_A plain RGB / mode_B alpha overlays) — same
# policy: regeneratable via each mode's sample/gen_samples.py; keep code + manifest.
p6/try-VLM-server/**/*.png
p6/try-VLM-server/**/*.jpg
p6/try-VLM-server/**/*.jpeg

# 沿用元の参考コード（他人のリポジトリの複製）— 2600 ファイル/73M で、
# 自分の作業ではない。必要な物は各実装側に取り込み済み（p3.2 の
# audio_common_msgs・soundmap 生成器・teleop_interface の構成）。
# 手元には残すが版管理はしない。
reference code/

# PC-C の run.sh が出す実行時ログ（log/ui.log などと pids）。
# 実行のたびに書き換わるもので、成果物ではない。
doctoral-thesis/p3.2/system/pc-c-operator/log/
